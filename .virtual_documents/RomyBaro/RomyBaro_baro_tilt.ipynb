def __stream_to_dataframe(st0):

    df0 = DataFrame()

    df0['time'] = st0[0].times(reftime=config['tbeg'])

    for tr in st0:
        cha = tr.stats.channel
        sta = tr.stats.station

        name = f"{sta}_{cha}"
        df0[name] = tr.data

    return df0


