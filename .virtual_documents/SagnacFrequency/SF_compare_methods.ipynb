def __makeplot_spectra(st01, st02, db=True):

    from numpy import log10
    import numpy as np

    arr1 = st01[0].data
    arr2 = st02[0].data

    f1, s1, p1 = __get_fft(arr1, st1[0].stats.delta, window="hann")
    f2, s2, p2 = __get_fft(arr2, st2[0].stats.delta, window="hann")

    if db:
        s1 = 20*log10(s1)
        s2 = 20*log10(s2)

    font = 12

    fig, ax = plt.subplots(1, 1, figsize=(12, 5))

    cols = ["tab:blue", "tab:red", "tab:orange", "tab:green", "darkblue"]

    ax.plot(f1, s1, color="tab:orange", label=st01[0].get_id(), alpha=0.8)

    ax.plot(f2, s2, color="tab:green", label=st02[0].get_id(), alpha=0.8, ls="-")

    ax2 = ax.twinx()

    ax2.fill_between(f2, 0, abs(s2-s1),
                     color="gray", alpha=0.4
                    )

    ax2.set_ylim(0, 60)
    ax2.set_ylabel(r"|PSD$_{1}$ - PSD$_{2}$| (dB wrt. 1 rad/s/$\sqrt{Hz}$)", fontsize=font)

    ax.set_xlabel("Frequenc (Hz)", fontsize=font)
    ax.set_ylabel(r"PSD (dB wrt. 1 rad/s/$\sqrt{Hz}$)", fontsize=font)

    # ax.vyscale("log")
    ax.set_xscale("log")

    ax.set_title(f"{str(config['tbeg'])[:19].replace('T',' ')} - {str(config['tend'])[:19].replace('T',' ')}")

    ax.grid(ls="--", color="gray", alpha=0.4, which="both")

    ax.set_ylim(-300, -150)
    ax.set_xlim(1e-3, 5e0)

    ax.legend(ncol=2)

    axy = np.linspace(ax.get_yticks()[0], ax.get_yticks()[-1], len(ax.get_yticks()))
    ax2y = np.linspace(ax2.get_yticks()[0], ax2.get_yticks()[-1], len(ax.get_yticks()))
    ax2.set_yticks(ax2y)

    plt.show();
    return fig


def __makeplot_spectra_all(st0):

    spec = {}
    freq = {}

    for tr in st0:

        loc = tr.get_id()
        freq[loc], spec[loc], _ = __get_fft(tr.data, tr.stats.delta, window="hann")

    fig, ax = plt.subplots(1, 1, figsize=(15, 5))

    font = 12

    for k in spec.keys():

        plt.plot(freq[k], 20*np.log10(spec[k]), label=k)

    plt.xscale("log")
    # plt.yscale("log")

    plt.legend()

    plt.grid(which="both", ls="--")

    plt.xlabel(r"Frequency (Hz)", fontsize=font)
    plt.ylabel(r"Spectrum (dB wrt. 1 rad/s/$\sqrt{Hz}$)", fontsize=font)

    plt.show();
    return fig


def __makeplot_coherence(st01, st02):

    import numpy as np
    from numpy import log10
    from functions.multitaper_coherence import __multitaper_coherence

    arr1 = st01[0].data
    arr2 = st02[0].data

    id1 = st01[0].get_id()
    id2 = st02[0].get_id()

    dt = st1[0].stats.delta

    out = __multitaper_coherence(arr1, arr2, dt, n_taper=10)

    font = 12

    fig, ax = plt.subplots(1, 1, figsize=(12, 5))

    ax.plot(out['fcoh'], out['coh'], color="k", label=f"{id1} - {id2}")

    ax.set_xlabel("Frequenc (Hz)", fontsize=font)
    ax.set_ylabel(r" Coherency", fontsize=font)

    # ax.vyscale("log")
    ax.set_xscale("log")

    ax.set_title(f"{str(config['tbeg'])[:19].replace('T',' ')} - {str(config['tend'])[:19].replace('T',' ')}")

    ax.grid(ls="--", color="gray", alpha=0.4, which="both")

    ax.set_xlim(1e-3, 5e0)
    ax.set_ylim(0, 1.05)

    ax.legend(ncol=2)

    plt.show();
    return fig


