def __makeplot_filtered_waveforms(st0, channel="Z", octave_fraction=6, fmin=0.01, fmax=0.2):

    from functions.cross_correlation import __cross_correlation

    fl, fu, fc = __get_octave_bands(fmin, fmax, faction_of_octave=octave_fraction)

    fig, ax = plt.subplots(1, 1, figsize=(12 ,7))

    font = 12

    for n, (f1, f2, fx) in enumerate(zip(fl, fu, fc)):

        s1 = st0.copy().select(station="ROMY", location="30", channel=f"*J{channel}")
        s2 = st0.copy().select(station="ROMY", location="22", channel=f"*J{channel}")

        s1 = s1.detrend("demean").taper(0.01)
        s1 = s1.filter("bandpass", freqmin=f1, freqmax=f2, corners=4, zerophase=True);

        s2 = s2.detrend("demean").taper(0.01)
        s2 = s2.filter("bandpass", freqmin=f1, freqmax=f2, corners=4, zerophase=True);

        cm, cl = __cross_correlation(s1[0].data, s2[0].data, s1[0].stats.delta, zerolag=False)

        norm = max([max(abs(s1[0].data)), max(abs(s2[0].data))])
        norm = 5e-9

        ax.plot(s1[0].times(), n+s1[0].data/norm*0.5, color="black", lw=0.7)
        ax.plot(s2[0].times(), n+s2[0].data/norm*0.5, color="darkred", lw=0.7)

        x0, y0 = s1[0].times()[-1], s1[0].data[-1]

        txt = f"CC={cm}, Lag={round(cl, 2)}s"
        plt.text(x0, y0+n-0.05, txt, ha='right', va='top', fontsize=font-2)

        x1 = s1[0].times()[0]
        txt = f"fc={int(fx*1e3)}mHz, df={int((f2-f1)*1e3)}mHz"
        plt.text(x1, y0+n-0.05, txt, ha='left', va='top', fontsize=font-2)

    ax.set_yticklabels([])
    ax.spines['left'].set_color('none')
    ax.spines['right'].set_color('none')
    ax.spines['top'].set_color('none')
    ax.tick_params(axis='y', which='both', left=False, right=False)

    plt.show();

__makeplot_filtered_waveforms(st0, channel="N", octave_fraction=6, fmin=0.05, fmax=0.2)








