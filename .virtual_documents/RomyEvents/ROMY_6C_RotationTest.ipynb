def __get_psd(tr):

    from functions.smoothing import __smooth
    from functions.multitaper_psd import __multitaper_psd
    from functions.welch_psd import __welch_psd
    from functions.get_fband_average import __get_fband_average
    from numpy import log10

    psds, psds_smth = [], []
    comp = ["Z", "N", "E"]
    ff, ffsmth = [], []

    dfout = {}

    dt = tr.stats.delta

    comp = tr.stats.channel[-1]

    _f, _psd = __multitaper_psd(tr.data, dt, n_win=15, time_bandwidth=3.5)
    # _f, _psd = __welch_psd(tr.data, dt, twin_sec=3600)

    _psd = 10*log10(_psd)

    dfout['psd'] = _psd
    dfout['frq'] = _f

    out = __get_fband_average(_f, _psd, faction_of_octave=12, average='mean', plot=False)

    dfout['psd_avg'] = out['psd_means']
    dfout['frq_avg'] = out['fcenter']

    return dfout


